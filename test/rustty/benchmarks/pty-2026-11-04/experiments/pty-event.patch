+pub struct LocalClientSender {
+    id: u64,
+    tx: SyncSender<Event>,
+}
+impl LocalClientSender {
+    pub fn send(&self, request: Request) -> io::Result<()> {
+        self.tx.try_send(Event::Request { id: self.id, request }).map_err(|error| {
+            io::Error::new(match error { TrySendError::Full(_) => io::ErrorKind::WouldBlock, TrySendError::Disconnected(_) => io::ErrorKind::BrokenPipe }, "server request queue unavailable")
+        })
+    }
+}
